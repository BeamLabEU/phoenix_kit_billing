msgid ""
"## Credit note {{credit_note_number}}\n"
"\n"
"Hello {{user_name}},\n"
"\n"
"We have issued a refund of **{{refund_amount}} {{currency}}** for invoice {{invoice_number}}.\n"
"\n"
"- Credit note: {{credit_note_number}}\n"
