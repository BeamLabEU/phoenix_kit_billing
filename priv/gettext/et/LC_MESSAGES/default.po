#: lib/phoenix_kit_billing/email_defaults.ex
msgid "=============================================\nINVOICE {{invoice_number}}\n=============================================\n\nBill To: {{user_name}}\nEmail: {{user_email}}\n\nInvoice Date: {{invoice_date}}\nDue Date: {{due_date}}\nCurrency: {{currency}}\n\n---------------------------------------------\nLINE ITEMS\n---------------------------------------------\n{{line_items_text}}\n\n---------------------------------------------\nSUMMARY\n---------------------------------------------\nSubtotal:    {{subtotal}} {{currency}}\nTax:         {{tax_amount}} {{currency}}\n---------------------------------------------\nTOTAL:       {{total}} {{currency}}\n---------------------------------------------\n\nPAYMENT DUE: {{due_date}}\n{{payment_terms}}\n\n---------------------------------------------\nBANK TRANSFER DETAILS\n---------------------------------------------\nBank:        {{bank_name}}\nIBAN:        {{bank_iban}}\nSWIFT/BIC:   {{bank_swift}}\nReference:   {{invoice_number}}\n\n---------------------------------------------\nView invoice online: {{invoice_url}}\n\n=============================================\n{{company_name}}\n{{company_address}}\nVAT: {{company_vat}}\n=============================================\n\nIf you have any questions about this invoice, please contact us."
msgstr "=============================================\nARVE {{invoice_number}}\n=============================================\n\nSaaja: {{user_name}}\nE-post: {{user_email}}\n\nArve kuupäev: {{invoice_date}}\nMaksetähtaeg: {{due_date}}\nValuuta: {{currency}}\n\n---------------------------------------------\nREAD\n---------------------------------------------\n{{line_items_text}}\n\n---------------------------------------------\nKOKKUVÕTE\n---------------------------------------------\nVahesumma:   {{subtotal}} {{currency}}\nKäibemaks:   {{tax_amount}} {{currency}}\n---------------------------------------------\nKOKKU:       {{total}} {{currency}}\n---------------------------------------------\n\nMAKSETÄHTAEG: {{due_date}}\n{{payment_terms}}\n\n---------------------------------------------\nPANGAÜLEKANDE ANDMED\n---------------------------------------------\nPank:        {{bank_name}}\nIBAN:        {{bank_iban}}\nSWIFT/BIC:   {{bank_swift}}\nViide:       {{invoice_number}}\n\n---------------------------------------------\nVaata arvet veebis: {{invoice_url}}\n\n=============================================\n{{company_name}}\n{{company_address}}\nKMKR: {{company_vat}}\n=============================================\n\nKui teil on selle arve kohta küsimusi, võtke meiega ühendust."

#: lib/phoenix_kit_billing/email_defaults.ex
msgid "=============================================\nRECEIPT {{receipt_number}}\n=============================================\nSTATUS: PAID\n\nThank you for your payment!\nYour payment has been successfully processed.\n\n---------------------------------------------\nRECEIVED FROM\n---------------------------------------------\nName: {{user_name}}\nEmail: {{user_email}}\n\nPayment Date: {{payment_date}}\nInvoice: {{invoice_number}}\nCurrency: {{currency}}\n\n---------------------------------------------\nLINE ITEMS\n---------------------------------------------\n{{line_items_text}}\n\n---------------------------------------------\nSUMMARY\n---------------------------------------------\nSubtotal:    {{subtotal}} {{currency}}\nTax:         {{tax_amount}} {{currency}}\n---------------------------------------------\nTOTAL PAID:  {{paid_amount}} {{currency}}\n---------------------------------------------\n\nPAYMENT CONFIRMED: {{payment_date}}\n\n---------------------------------------------\nView receipt online: {{receipt_url}}\n\n=============================================\n{{company_name}}\n{{company_address}}\nVAT: {{company_vat}}\n=============================================\n\nThank you for your business.\nIf you have any questions, please contact us."
msgstr "=============================================\nKVIITUNG {{receipt_number}}\n=============================================\nOLEK: MAKSTUD\n\nTäname makse eest!\nTeie makse on edukalt töödeldud.\n\n---------------------------------------------\nMAKSJA\n---------------------------------------------\nNimi: {{user_name}}\nE-post: {{user_email}}\n\nMakse kuupäev: {{payment_date}}\nArve: {{invoice_number}}\nValuuta: {{currency}}\n\n---------------------------------------------\nREAD\n---------------------------------------------\n{{line_items_text}}\n\n---------------------------------------------\nKOKKUVÕTE\n---------------------------------------------\nVahesumma:   {{subtotal}} {{currency}}\nKäibemaks:   {{tax_amount}} {{currency}}\n---------------------------------------------\nMAKSTUD:     {{paid_amount}} {{currency}}\n---------------------------------------------\n\nMAKSE KINNITATUD: {{payment_date}}\n\n---------------------------------------------\nVaata kviitungit veebis: {{receipt_url}}\n\n=============================================\n{{company_name}}\n{{company_address}}\nKMKR: {{company_vat}}\n=============================================\n\nTäname, et valisite meid.\nKui teil on küsimusi, võtke meiega ühendust."

#: lib/phoenix_kit_billing/email_defaults.ex
msgid "=============================================\nCREDIT NOTE {{credit_note_number}}\n=============================================\nSTATUS: REFUND ISSUED\n\nA refund has been processed for your account.\n\nREFUND AMOUNT: {{refund_amount}} {{currency}}\n\n---------------------------------------------\nISSUED BY (PAYER)\n---------------------------------------------\n{{company_name}}\n{{company_address}}\nVAT: {{company_vat}}\n\n---------------------------------------------\nISSUED TO (PAYEE)\n---------------------------------------------\nName: {{user_name}}\nEmail: {{user_email}}\n\n---------------------------------------------\nREFUND DETAILS\n---------------------------------------------\nCredit Note #:     {{credit_note_number}}\nRefund Date:       {{refund_date}}\nRefund Amount:     {{refund_amount}} {{currency}}\nOriginal Invoice:  {{invoice_number}}\nTransaction #:     {{transaction_number}}\n\n---------------------------------------------\nREASON FOR REFUND\n---------------------------------------------\n{{refund_reason}}\n\n---------------------------------------------\nView credit note online: {{credit_note_url}}\n\nThe refund will be processed to your original payment method.\nPlease allow 5-10 business days for the refund to appear in your account.\n\n=============================================\n{{company_name}}\n{{company_address}}\nVAT: {{company_vat}}\n=============================================\n\nIf you have any questions about this refund, please contact us."
msgstr "=============================================\nKREEDITARVE {{credit_note_number}}\n=============================================\nOLEK: TAGASIMAKSE TEHTUD\n\nTeie kontole on tehtud tagasimakse.\n\nTAGASIMAKSE SUMMA: {{refund_amount}} {{currency}}\n\n---------------------------------------------\nVÄLJASTAJA (MAKSJA)\n---------------------------------------------\n{{company_name}}\n{{company_address}}\nKMKR: {{company_vat}}\n\n---------------------------------------------\nSAAJA\n---------------------------------------------\nNimi: {{user_name}}\nE-post: {{user_email}}\n\n---------------------------------------------\nTAGASIMAKSE ANDMED\n---------------------------------------------\nKreeditarve nr:    {{credit_note_number}}\nTagasimakse kuupäev: {{refund_date}}\nTagasimakse summa: {{refund_amount}} {{currency}}\nAlgne arve:        {{invoice_number}}\nTehingu nr:        {{transaction_number}}\n\n---------------------------------------------\nTAGASIMAKSE PÕHJUS\n---------------------------------------------\n{{refund_reason}}\n\n---------------------------------------------\nVaata kreeditarvet veebis: {{credit_note_url}}\n\nTagasimakse tehakse teie algsele makseviisile.\nPalun arvestage, et summa jõuab kontole 5-10 tööpäeva jooksul.\n\n=============================================\n{{company_name}}\n{{company_address}}\nKMKR: {{company_vat}}\n=============================================\n\nKui teil on selle tagasimakse kohta küsimusi, võtke meiega ühendust."

#: lib/phoenix_kit_billing/email_defaults.ex
msgid "=============================================\nPAYMENT CONFIRMATION {{confirmation_number}}\n=============================================\nSTATUS: PAYMENT RECEIVED\n\nThank you for your payment.\n\nPAYMENT AMOUNT: {{payment_amount}} {{currency}}\n\n---------------------------------------------\nPAYMENT DETAILS\n---------------------------------------------\nConfirmation #:    {{confirmation_number}}\nInvoice #:         {{invoice_number}}\nPayment Date:      {{payment_date}}\nPayment Method:    {{payment_method}}\nTransaction #:     {{transaction_number}}\n\n---------------------------------------------\nBALANCE SUMMARY\n---------------------------------------------\nInvoice Total:     {{invoice_total}} {{currency}}\nTotal Paid:        {{total_paid}} {{currency}}\nRemaining:         {{remaining_balance}} {{currency}}\n\n---------------------------------------------\nView payment confirmation online: {{payment_url}}\n\n=============================================\n{{company_name}}\n{{company_address}}\n=============================================\n\nThank you for your business. If you have any questions, please contact us."
msgstr "=============================================\nMAKSE KINNITUS {{confirmation_number}}\n=============================================\nOLEK: MAKSE LAEKUNUD\n\nTäname makse eest.\n\nMAKSE SUMMA: {{payment_amount}} {{currency}}\n\n---------------------------------------------\nMAKSE ANDMED\n---------------------------------------------\nKinnituse nr:      {{confirmation_number}}\nArve nr:           {{invoice_number}}\nMakse kuupäev:     {{payment_date}}\nMakseviis:         {{payment_method}}\nTehingu nr:        {{transaction_number}}\n\n---------------------------------------------\nSALDO KOKKUVÕTE\n---------------------------------------------\nArve kogusumma:    {{invoice_total}} {{currency}}\nMakstud kokku:     {{total_paid}} {{currency}}\nJääk:              {{remaining_balance}} {{currency}}\n\n---------------------------------------------\nVaata makse kinnitust veebis: {{payment_url}}\n\n=============================================\n{{company_name}}\n{{company_address}}\n=============================================\n\nTäname, et valisite meid. Kui teil on küsimusi, võtke meiega ühendust."

